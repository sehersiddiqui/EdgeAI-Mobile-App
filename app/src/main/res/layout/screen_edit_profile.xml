<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/TextHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_profile_heading" />

    <TextView
        style="@style/TextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:text="@string/edit_profile_subheading" />

    <EditText
        android:id="@+id/input_name"
        style="@style/Input.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:hint="@string/hint_full_name"
        android:singleLine="true" />

    <EditText
        android:id="@+id/input_mobile"
        style="@style/Input.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:hint="@string/hint_mobile"
        android:inputType="phone"
        android:singleLine="true" />

    <EditText
        android:id="@+id/input_age"
        style="@style/Input.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:hint="@string/hint_age"
        android:singleLine="true" />

    <EditText
        android:id="@+id/input_gender"
        style="@style/Input.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:hint="@string/hint_gender"
        android:singleLine="true" />

    <EditText
        android:id="@+id/input_address"
        style="@style/Input.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:hint="@string/hint_address" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_choose_photo"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:text="@string/action_choose_photo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_changes"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:text="@string/action_save_changes" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pick_map_address"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/action_pick_map_address" />
</LinearLayout>
