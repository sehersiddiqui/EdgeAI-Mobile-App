<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/TextHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_heading" />

    <TextView
        style="@style/TextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:text="@string/settings_subheading" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Card.Flat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg">

            <include
                android:id="@+id/nav_reading_appearance"
                layout="@layout/item_nav_row" />

            <include
                android:id="@+id/nav_reading_insights"
                layout="@layout/item_nav_row" />

            <include
                android:id="@+id/nav_privacy_data"
                layout="@layout/item_nav_row" />

            <include
                android:id="@+id/nav_help_faq"
                layout="@layout/item_nav_row" />

            <include
                android:id="@+id/nav_about"
                layout="@layout/item_nav_row" />

            <include
                android:id="@+id/nav_web_resources"
                layout="@layout/item_nav_row" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_log_out"
        style="@style/Button.Destructive"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/action_log_out" />
</LinearLayout>
