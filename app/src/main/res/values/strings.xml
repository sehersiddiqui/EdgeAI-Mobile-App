    <!-- Gaze -->
    <string name="gaze_heading">Live camera signals</string>
    <string name="gaze_subheading">This opens an on-device CameraX + ML Kit face/eye-landmark demo. It measures face presence, head yaw and eye-open probabilities. These are not point-of-regard estimates and are not a diagnosis.</string>
    <string name="gaze_card_title">What is measured?</string>
    <string name="gaze_card_body">• Face detection and tracking ID\n• Head yaw angle\n• Left/right eye-open probability\n• Frames analysed during this session</string>
    <string name="action_start_camera">Start live camera analysis</string>
    <string name="action_view_interpretation">View signal interpretation</string>
    <string name="gaze_note">Privacy: frames are processed locally and not saved by this demo. Camera permission is requested only when you start the analysis.</string>

