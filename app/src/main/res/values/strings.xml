    <!-- Insights -->
    <string name="insights_heading">Your reading insights</string>
    <string name="insights_subheading">Pip notices patterns to help you choose tools. These are illustrative demo signals unless a real, validated gaze model is connected.</string>
    <string name="insight_pattern_label">🔎  PATTERN SPOTTED</string>
    <string name="insight_pattern_title">A pause on a longer word</string>
    <string name="insight_pattern_body">Example evidence: “disagreeable” in The Secret Garden. The sample passage uses a demo fixation event at 720 ms, above the 600 ms prototype threshold.</string>
    <string name="insight_backtrack_label">↶  BACKTRACKING SIGNAL</string>
    <string name="insight_backtrack_title">2 demo regressions in this session</string>
    <string name="insight_backtrack_body">Prototype rule: a leftward movement on the same line is counted; &gt;3 within two sentences can suggest offering line focus. This is not a diagnosis.</string>
