<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
    </style>

    <!-- ===================== Text appearances ===================== -->
    <style name="TextDisplay">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextTitle">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextHeading">
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextLabel">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextCaption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <!-- ===================== Buttons ===================== -->
    <style name="Button.Base" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Button.Primary" parent="Button.Base">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/primary_dark</item>
    </style>

    <style name="Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="android:textColor">@color/ink</item>
        <item name="rippleColor">@color/primary_container</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Button.Destructive" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/destructive</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="android:textColor">@color/destructive</item>
        <item name="rippleColor">@color/destructive_container</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="rippleColor">@color/primary_container</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Button.Toggle.Off" parent="Button.Secondary">
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Button.Toggle.On" parent="Button.Base">
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <!-- ===================== Cards ===================== -->
    <style name="Card.Flat" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <style name="Card.Hero" parent="Card.Flat">
        <item name="cardBackgroundColor">@color/primary_container</item>
        <item name="strokeColor">@color/primary_container</item>
    </style>

    <!-- ===================== Inputs ===================== -->
    <style name="Input.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_faint</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- ===================== Nav tab ===================== -->
    <style name="NavTab">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
